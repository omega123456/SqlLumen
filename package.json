{
  "name": "sqllumen",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-cli.mjs",
    "test": "pnpm exec vitest run --reporter=default",
    "clean:rust-target": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "test:coverage": "pnpm exec vitest run --coverage --reporter=default",
    "test:rust": "cargo sqllumen-test-integration",
    "test:rust:coverage": "node scripts/run-rust-coverage.mjs",
    "test:all": "pnpm test:coverage && pnpm test:rust:coverage && pnpm test:e2e",
    "test:e2e": "node scripts/ensure-playwright-port.mjs && node scripts/run-playwright-e2e.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "mcp:tauri": "mcp-server-tauri",
    "release:tauri-version": "node scripts/bump-tauri-version.mjs"
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "6.0.3",
    "@glideapps/glide-data-grid-cells": "6.0.3",
    "@headlessui/react": "^2.2.10",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "monaco-editor": "^0.55.1",
    "monaco-sql-languages": "1.0.0",
    "react-colorful": "^5.8.1",
    "react-datepicker": "^9.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.7.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.9.0",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "_peerDependencyNote": "marked and react-responsive-carousel are transitive peer resolutions only, not direct dependencies. Accepted intentionally.",
      "allowedVersions": {
        "eslint": "10",
        "marked": ">=4",
        "react": "19",
        "react-dom": "19"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hypothesi/tauri-mcp-server": "^0.13.1",
    "@playwright/test": "~1.58.2",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jest-canvas-mock": "^2.5.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
